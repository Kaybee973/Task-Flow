# TaskFlow local development environment
# Copy this to .env and customize:
#   cp .env.example .env

# Server
PORT=8080

# PostgreSQL (values are picked up by docker-compose.yml)
PG_USER=taskflow
PG_PASSWORD=taskflow
PG_DATABASE=taskflow
PG_PORT=5432

# When set, the app uses PostgreSQL instead of in-memory storage.
# This matches the Docker Compose connection string:
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow?sslmode=disable
